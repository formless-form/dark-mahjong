<resources>
    <!-- Base application theme. -->
    <!-- Dark Mahjong is dark-only; the window background matches the Compose background so
         there is no light flash before the first frame -->
    <style name="Theme.Mahjong" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/dark_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>