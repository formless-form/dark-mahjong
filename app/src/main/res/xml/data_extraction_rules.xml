<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is backed up and moves to a new phone: progress, settings and the game in play
     (the only data the app keeps). The performance check and Low-performance mode are stored
     with the phone they belong to, and set aside on another (PreferencesRepository).
     With minSdk 33 this is the only backup configuration read. -->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
